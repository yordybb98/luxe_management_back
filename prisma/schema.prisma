//////////////////////////
//////////ENUMS///////////
//////////////////////////
enum Permission {
  ViewOrders
  ViewAllOrders
  AssignTechnician
  AssignDesigner
  FinishOrders
  FinishTasks
  EditTasks
  CancelTasks
  UploadProposal
  ViewRoles
  CreateRoles
  UpdateRoles
  DeleteRoles
  ViewUsers
  CreateUsers
  UpdateUsers
  DeleteUsers
  ViewAttendances
  ViewMyTasks
}

enum NotificationType {
  SUCCESS
  ERROR
  INFO
  WARNING
}

enum UserType {
  ADMIN
  TECHNICIAN
  DESIGNER
  FRONTDESK
}

///////////////////////////
//////////MODELS///////////
//////////////////////////
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  lastName      String?
  username      String         @unique
  email         String?        @unique
  password      String
  orders        Int[]
  role          Role           @relation(fields: [roleId], references: [id])
  roleId        Int
  phone         String?
  address       String?
  notifications Notification[]
  userType      UserType?
  disabled      Boolean        @default(false)
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String
  description String
  permissions Permission[]
  users       User[]
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  message   String
  type      NotificationType
  source    String?
  timestamp DateTime         @default(now())
  readed    Boolean          @default(false)
  user      User             @relation(fields: [userId], references: [id])
}
